# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Facebook / Instagram (Meta Graph API)
# Get from: https://developers.facebook.com -> Your App -> Graph API Explorer
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token

# Instagram Business Account
# Must be connected to your Facebook Page
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# LinkedIn
# Get from: https://www.linkedin.com/developers -> Your App -> Auth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_ORGANIZATION_ID=your_linkedin_organization_id  # urn:li:organization:XXXXXXX

# Google Drive Integration
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable "Google Drive API"
# 3. Go to APIs & Services → Credentials → Create OAuth 2.0 Client ID (Desktop app)
# 4. Download the JSON and save it as google_credentials.json in the backend/ folder
# 5. Restart the backend and visit http://localhost:8000/api/drive/auth to authorize
SOCIAL_MEDIA_DIR=C:\Users\HP\OneDrive\MenardProperties\Social Media
# Drive folder ID from https://drive.google.com/drive/folders/<id> — items chosen for publishing come from here
SOCIAL_MEDIA_FOLDER_ID=your_drive_folder_id
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_TOKEN_FILE=google_token.json

# App Config
DATABASE_URL=sqlite:///./social_media.db
UPLOAD_DIR=./uploads
SECRET_KEY=change_this_to_a_random_secret_key
