[Unit]
Description=Erin Menard Social Media Agent — FastAPI backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/social-media-agent/backend
EnvironmentFile=/home/ubuntu/social-media-agent/backend/.env
ExecStart=/home/ubuntu/social-media-agent/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
